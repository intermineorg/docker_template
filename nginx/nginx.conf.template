# Rendered into /etc/nginx/conf.d/default.conf when the container starts, by the
# official nginx image's envsubst step.  Only ${MINE}, ${PUBLIC_HOST},
# ${PUBLIC_SCHEME} and ${PUBLIC_PORT} are substituted (NGINX_ENVSUBST_FILTER in
# nginx.Dockerfile); nginx's own $host, $uri, $1 ... are left alone.
# PUBLIC_HOST/SCHEME/PORT are derived from PUBLIC_URL by public-url.envsh.
#
# TLS is terminated by the proxy in front of this container, which forwards to
# HTTP_PORT; that is why this only listens on port 80 and why X-Forwarded-Proto
# and X-Forwarded-Port describe the public URL rather than this hop.  Tomcat
# trusts these headers (RemoteIpValve in tomcat/configs/server.xml).
#
# Upstreams are held in variables and resolved through Docker's embedded DNS
# (127.0.0.11) at request time.  A literal "proxy_pass http://tomcat:8080" is
# resolved once at start-up, so nginx would refuse to start while tomcat or
# bluegenes does not exist and would keep a stale IP after either is recreated.
# With variables, tomcat/bluegenes can be restarted or recreated independently
# and nginx never needs to be restarted along with them.

server {
	listen 80;
	server_name ${PUBLIC_HOST};
	resolver 127.0.0.11 valid=10s ipv6=off;
	set $tomcat http://tomcat:8080;
	set $bluegenes http://bluegenes:5000;
	set $jbrowse http://jbrowse:80;
	set $aligner http://aligner:3000;
	error_log /var/log/nginx/${PUBLIC_HOST}_err.log warn;
	access_log /var/log/nginx/${PUBLIC_HOST}_access.log combined;
	gzip on;
	gzip_types text/css text/javascript application/javascript application/json text/plain image/svg+xml;

	# robots.txt, sitemap.xml ... (mount a directory at /var/www/${MINE} to use this)
	location ~ ^/([A-z0-9\-]+\.(xml|txt))$ {
		alias /var/www/${MINE}/$1;
	}
	# BlueGenes answers /favicon.ico with a redirect to its *backend* service
	# root, which here is http://tomcat:8080/${MINE}/... - an address the browser
	# cannot reach, and blocked as mixed content on an https site.  Serve the
	# mine's own icon directly instead, so the internal name never leaves the
	# stack.  Drop this block if you ship a favicon.ico with BlueGenes itself.
	location = /favicon.ico {
		rewrite ^ /${MINE}/model/images/favicon.ico break;
		proxy_pass $tomcat;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_hide_header Set-Cookie;
		expires 1d;
	}
	# BlueGenes tools (JBrowse, protein visualizer, expression viewers ...)
	# are npm packages that expect the InterMine JS client as a global,
	# window.imjs.  BlueGenes used to load it from cdn.intermine.org on every
	# page; dev commit 06363a30 (Oct 2024, in images built after Jan 2025)
	# dropped that tag because the CDN had died, and since then every tool
	# throws "imjs is not defined" and renders an empty panel.  Until
	# BlueGenes ships the client itself, this serves a pinned copy and adds
	# one script tag to BlueGenes' HTML on the way through.
	location /vendor/ {
		alias /usr/share/nginx/vendor/;
		expires 30d;
	}
	location / {
		proxy_pass $bluegenes;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		# sub_filter needs an uncompressed upstream body; clients still get
		# gzip from this server (gzip on, above).  Only text/html is filtered.
		proxy_set_header Accept-Encoding "";
		sub_filter '</head>' '<script src="/vendor/imjs/im.min.js"></script></head>';
		sub_filter_once on;
	}
	location /${MINE}/service {
		proxy_pass $tomcat;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
	}
	location /${MINE}/model {
		proxy_pass $tomcat;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
	}
	# InterMine fetches its own query schemas from webapp.baseurl on every
	# query-service call (webservice/query.xsd, webservice/query.schema).  If
	# this fell through to BlueGenes the webapp would get HTML instead: XML
	# queries would silently skip validation and JSON queries would fail.
	location /${MINE}/webservice {
		proxy_pass $tomcat;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
	}
	# The classic JSP webapp, published under /query
	location /query {
		rewrite ^/query(.*)$ /${MINE}$1 break;
		proxy_pass $tomcat;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
	}
	# Optional: JBrowse served under this mine's own hostname, with no extra
	# public port. Requires the jbrowse container (from
	# https://github.com/intermineorg/jbrowse) to be joined
	# to this project's frontend network. The upstream is a variable, so nginx
	# starts and serves the mine even when no jbrowse container exists.
	location /jbrowse/ {
		rewrite ^/jbrowse/(.*)$ /$1 break;
		proxy_pass $jbrowse;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
	}
	location = /jbrowse {
		absolute_redirect off;
		return 301 /jbrowse/;
	}
	# Optional: the sequence-alignment service behind the BlueGenes MSA viewer
	# (https://github.com/intermineorg/sequence-alignment-service), reached
	# same-origin as /align-sequence; the installed tool is patched to use that
	# path (README, "BlueGenes tools that call dead external services"). The
	# upstream is a variable, so nginx starts without an aligner container.
	location = /align-sequence {
		proxy_pass $aligner;
		proxy_set_header Host $host;
	}
	location /come {
		proxy_pass $tomcat;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
		proxy_set_header X-Forwarded-Port ${PUBLIC_PORT};
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
	}
}
