MINE=somemine
# Suffix for container names (${MINE}${INSTANCE}_tomcat ...).  Leave empty for
# production; set e.g. INSTANCE=_test in a second copy of this directory so both
# deployments can run on the same host (see README, "Parallel test deployment").
INSTANCE=
HTTP_PORT=14808
GID=1010
# Public origin of the site: scheme + host (+ :port only if non-standard), NO path,
# NO trailing slash.  docker-compose passes it to BlueGenes (service root) and to
# the builder container (WEBAPP_BASEURL), which writes it into webapp.baseurl in
# data/properties.intermine/${MINE}.properties.  webapp.baseurl is the URL InterMine
# embeds in generated code, permalinks, e-mails and OAuth2 redirects.
PUBLIC_URL=https://www.somemine.org
